# Copy to .env and fill in. Never commit .env.
# The centre of the circle overhead watches (default: Toronto Pearson). Load with: set -a; . ./.env; set +a
# OVERHEAD_LAT=43.6777
# OVERHEAD_LON=-79.6248
# RabbitMQ (compose.yaml) and where enrich/history keep their files.
# OVERHEAD_AMQP=amqp://overhead:overhead@localhost:5673/
# OVERHEAD_DATA=./data
# OVERHEAD_ADDR=:8090
# The time zone of "today" on the screen, in facts and heads-ups (default: the system's).
# OVERHEAD_TZ=America/Toronto
# The window the screen draws (README: Window setup): direction it faces, how wide, the lowest and highest angles
# you can see from where you sit, and the home's height above sea level.
# OVERHEAD_WINDOW_AZ=180
# OVERHEAD_WINDOW_FOV=100
# OVERHEAD_WINDOW_MIN_EL=8
# OVERHEAD_WINDOW_MAX_EL=40
# OVERHEAD_HOME_ELEV=170
# Heads-ups to the phone (optional): a bot from @BotFather and the chat id.
# OVERHEAD_TELEGRAM_TOKEN=
# OVERHEAD_TELEGRAM_CHAT=
