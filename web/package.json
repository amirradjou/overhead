{
  "name": "overhead-screen",
  "version": "0.1.0",
  "private": true,
  "description": "overhead's window screen: the planes outside the window, fed by `overhead live` over Server-Sent Events",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "prettier --check . && tsc --noEmit",
    "screen-check": "node scripts/screen-check.mjs",
    "record-replay": "node scripts/record-replay.mjs"
  },
  "browserslist": [
    "chrome >= 79",
    "safari >= 14",
    "firefox >= 78"
  ],
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "suncalc": "2.1.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
